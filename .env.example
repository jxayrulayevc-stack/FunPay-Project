# Telegram: числовой ID админа и начальный токен бота.
# Токен и куки, сохранённые через /token и /cookie в SQLite, имеют приоритет над .env.
ADMIN_ID=123456789
BOT_TOKEN=123456789:AA_REPLACE_WITH_REAL_TELEGRAM_BOT_TOKEN

# Пути (по умолчанию ./data и ./logs внутри каталога проекта).
# DATA_DIR=/opt/funpay-helper/data
# LOG_DIR=/opt/funpay-helper/logs

# Логирование и режимы.
LOG_LEVEL=INFO
DEBUG=0
DRY_RUN=0

# FunPay long-polling.
FUNPAY_POLL_INTERVAL=6
ACCOUNT_REFRESH_MINUTES=45
FUNPAY_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Надёжность.
HEARTBEAT_INTERVAL=60
HEARTBEAT_MAX_AGE=180
WATCHDOG_TIMEOUT=180
FUNPAY_UNAVAILABLE_AFTER=300

# Опционально: Healthchecks.io. По умолчанию выключено.
# HEALTHCHECKS_URL=https://hc-ping.com/your-uuid
